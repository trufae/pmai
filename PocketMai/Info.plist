<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Mai Archive</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>io.github.trufae.mai.conversation</string>
			</array>
		</dict>
	</array>
	<key>CFBundleName</key>
	<string>PocketMai</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>PocketMai can include your current location in prompts when the Location tool is enabled.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>PocketMai scans for Ollama servers and can serve the selected chat to local Ollama or OpenAI-compatible clients.</string>
	<key>NSCameraUsageDescription</key>
	<string>PocketMai uses the camera to attach a picture to your chat when you choose Take picture.</string>
	<key>NSAlarmKitUsageDescription</key>
	<string>PocketMai can schedule alarms only when the Alarms tool is enabled and called in chat.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>PocketMai can read your calendar events only when the Calendar tool is enabled and called in chat.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>PocketMai can read your calendar events only when the Calendar tool is enabled and called in chat.</string>
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>PocketMai can create calendar events only when Calendar event creation is enabled in Settings and the create-event tool is called.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>PocketMai uses the microphone for active voice conversations. When Native iOS Live is selected, raw microphone audio stays on this device.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>PocketMai saves chat images to your photo library when you choose Save Image.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>PocketMai uses speech recognition to turn your voice into chat messages and to transcribe voice messages shared from other apps. Native iOS Live transcription happens on device.</string>
	<key>NSUbiquitousContainers</key>
	<dict>
		<key>iCloud.io.github.trufae.mai</key>
		<dict>
			<key>NSUbiquitousContainerIsDocumentScopePublic</key>
			<false/>
			<key>NSUbiquitousContainerName</key>
			<string>PocketMai</string>
			<key>NSUbiquitousContainerSupportedFolderLevels</key>
			<string>Any</string>
		</dict>
	</dict>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>processing</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER).response.*</string>
	</array>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Mai Archive</string>
			<key>UTTypeIdentifier</key>
			<string>io.github.trufae.mai.conversation</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>pocketmai.json</string>
				</array>
				<key>public.mime-type</key>
				<string>application/vnd.pocketmai+json</string>
			</dict>
		</dict>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.pocketmai.oauth</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>pocketmai</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
