     }
 
+    func test_uploadResumesAfterSocketBackpressure() async throws {
+        // Exercise both URLRequest.httpBody and uploadTask's separate body.
+        // The peer echoes the entire body, so delegate progress alone cannot
+        // make this pass if the socket stops sending after its first buffer.
+        let body = Data(repeating: 0x61, count: 1024 * 1024)
+        let url = try XCTUnwrap(URL(string: "http://127.0.0.1:\(Self.serverPort)/echo-with-backpressure"))
+        for uploadTask in [false, true] {
+            let configuration = URLSessionConfiguration.ephemeral
+            configuration.timeoutIntervalForResource = 45
+            let session = URLSession(configuration: configuration)
+            defer { session.invalidateAndCancel() }
+            var request = URLRequest(url: url)
+            request.httpMethod = uploadTask ? "PUT" : "POST"
+            request.timeoutInterval = 30
+            request.setValue("100-continue", forHTTPHeaderField: "Expect")
+            let completed = expectation(description: "complete upload, uploadTask=\(uploadTask)")
+            let completion: @Sendable (Data?, URLResponse?, Error?) -> Void = { data, response, error in
+                defer { completed.fulfill() }
+                XCTAssertNil(error)
+                XCTAssertEqual((response as? HTTPURLResponse)?.statusCode, 200)
+                XCTAssertEqual(data, body)
+            }
+            let task: URLSessionTask
+            if uploadTask {
+                task = session.uploadTask(with: request, from: body, completionHandler: completion)
+            } else {
+                request.httpBody = body
+                task = session.dataTask(with: request, completionHandler: completion)
+            }
+            task.resume()
+            await fulfillment(of: [completed], timeout: 60)
+            task.cancel()
+        }
+    }
+
