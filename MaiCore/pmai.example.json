{
  "version": 1,
  "defaultAgent": "hello",
  "prompts": {
    "compact": "Compact the transcript for continuing the chat.\n\nFocus: {{focus}}\n\n{{transcript}}",
    "system": {
      "hello": "Exercise the offline MaiCore provider.",
      "main": "You are a helpful assistant. Use tools when needed.",
      "researcher": "Investigate the delegated task and return a concise result."
    },
    "delegation": "## Context\n\n{{context}}\n\n## Task\n\n{{task}}\n\n## Expected output\n\n{{output}}\n\nYou are running as agent '{{agent}}' in {{cwd}}. Everything you need is above.",
    "worker": "You are a focused worker agent. Use your tools to complete the task, then reply with exactly the expected output and nothing else.",
    "memory": "Extract durable user memory from these conversations and merge it with what is already known.\n\nFocus: {{focus}}\n\n## Existing memory\n\n{{memory}}\n\n## Conversations\n\n{{transcript}}"
  },
  "plugins": [
    {
      "path": "./plugins/example.dylib",
      "enabled": false,
      "required": false
    }
  ],
  "providers": [
    {
      "id": "hello",
      "kind": "hello"
    },
    {
      "id": "openai",
      "kind": "openAICompatible",
      "displayName": "OpenAI",
      "baseURL": "https://api.openai.com/v1",
      "apiKeyEnvironment": "OPENAI_API_KEY"
    },
    {
      "id": "local",
      "kind": "openAICompatible",
      "displayName": "Local OpenAI-compatible server",
      "baseURL": "http://127.0.0.1:8080/v1"
    },
    {
      "id": "opencode",
      "kind": "openAICompatible",
      "displayName": "OpenCode Go",
      "baseURL": "https://opencode.ai/zen/go/v1",
      "apiKeyEnvironment": "OPENCODE_API_KEY",
      "headers": [
        "x-opencode-session: {{session}}"
      ]
    },
    {
      "id": "gemini",
      "kind": "acp",
      "displayName": "Gemini (ACP)",
      "options": {
        "command": "gemini",
        "args": [
          "--acp"
        ],
        "permission": "auto"
      }
    }
  ],
  "toolSources": [
    {
      "id": "standard-tools",
      "kind": "standard-tools",
      "options": {
        "filesRoot": ".",
        "filesWriteEnabled": true,
        "runShell": "/bin/sh",
        "runTimeoutSeconds": 60,
        "webSearchProvider": "exa",
        "weatherLocation": "",
        "mastodonInstance": "mastodon.social",
        "mastodonAPIKeyEnvironment": "MASTODON_API_KEY",
        "mastodonWriteEnabled": false
      }
    },
    {
      "id": "example-tools",
      "kind": "example",
      "enabled": false
    }
  ],
  "ocrProviders": [
    {
      "id": "vision",
      "kind": "vision"
    }
  ],
  "mcpServers": [
    {
      "id": "remote",
      "kind": "streamable-http",
      "enabled": false,
      "displayName": "Example MCP",
      "url": "https://your-mcp.example/mcp",
      "bearerTokenEnvironment": "MCP_API_KEY",
      "toolNamePrefix": "remote",
      "defaultApproval": "confirm"
    },
    {
      "id": "local",
      "enabled": false,
      "displayName": "Example local MCP",
      "command": "your-mcp-server",
      "args": [
        "--stdio"
      ],
      "env": {},
      "cwd": ".",
      "toolNamePrefix": "local",
      "defaultApproval": "confirm"
    }
  ],
  "agents": [
    {
      "id": "hello",
      "displayName": "Offline hello",
      "instructions": "Exercise the offline MaiCore provider.",
      "systemPrompt": "hello",
      "provider": "hello",
      "model": "",
      "description": "Offline smoke test; no tools, no network.",
      "enabled": true
    },
    {
      "id": "main",
      "displayName": "Main agent",
      "instructions": "You are a helpful assistant. Use tools when needed.",
      "systemPrompt": "main",
      "provider": "openai",
      "model": "your-model",
      "toolNames": [
        "calc",
        "chats_list",
        "chats_read",
        "chats_read_document",
        "chats_search",
        "current_time",
        "files_delete",
        "files_find",
        "files_grep",
        "files_list",
        "files_read",
        "files_rename",
        "files_write",
        "github_ci_log",
        "github_ci_status",
        "github_commit",
        "github_commits",
        "github_issue",
        "github_issues",
        "github_list_files",
        "github_list_prs",
        "github_pr",
        "github_pr_diff",
        "github_read_file",
        "github_releases",
        "mastodon",
        "run_sh",
        "todo_add",
        "todo_done",
        "todo_list",
        "weather",
        "web_fetch",
        "web_search"
      ],
      "toolGroupNames": [
        "calc",
        "chats",
        "datetime",
        "files",
        "github",
        "mastodon",
        "run",
        "todo",
        "weather",
        "web"
      ],
      "subagentNames": [
        "researcher"
      ],
      "toolCallingStrategy": "automatic",
      "useToolProxy": true,
      "limits": {
        "maxModelTurns": 60,
        "maxToolCalls": 50,
        "maxSubagents": 5,
        "maxSubagentDepth": 5
      },
      "description": "General assistant with the full tool set.",
      "toolDelegation": "subagent",
      "enabled": true
    },
    {
      "id": "researcher",
      "displayName": "Researcher",
      "instructions": "Investigate the delegated task and return a concise result.",
      "systemPrompt": "researcher",
      "provider": "openai",
      "model": "your-model",
      "toolNames": [
        "current_time"
      ],
      "toolGroupNames": [
        "datetime"
      ],
      "description": "Investigates one question and answers in a few lines.",
      "enabled": true
    },
    {
      "id": "gemini",
      "displayName": "Gemini",
      "description": "External Gemini agent driven over ACP.",
      "enabled": true,
      "provider": "gemini",
      "model": "gemini"
    }
  ],
  "ui": {
    "title": "",
    "editor": "",
    "bgline": "rgb:024",
    "fgprompt": "yellow",
    "fgcolor": "",
    "bgcolor": "",
    "bgprompt": "",
    "fgtoolresult": "yellow",
    "bold": false,
    "markdown": true,
    "toolResultLines": -1
  },
  "approvals": {
    "confirm": "ask",
    "dangerous": "ask",
    "yolo": false
  },
  "memory": {
    "enabled": true,
    "scope": "project"
  }
}
